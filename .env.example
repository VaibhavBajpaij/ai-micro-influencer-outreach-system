# ==============================================================================
# EDXSO AI Engineer Intern - Automated Micro-Influencer Outreach System
# ==============================================================================

# --- Campaign & Brand Profile ---
BRAND_NAME=VoltFlow
BRAND_PRODUCT=VoltFlow Workspace - an AI-powered desk hardware & developer productivity suite
BRAND_VALUE_PROP=early access to our flagship smart-dock + paid creator sponsorship and 20% recurring affiliate rev-share
DEFAULT_NICHE=technology

# --- API Security (Required for API reads, mutating HTTP endpoints & n8n calls) ---
# Generate a strong secret token locally; never commit real secrets or expose in frontend HTML.
OUTREACH_API_KEY=change-me-local-dev-token
ALLOW_LIVE_SMTP=false

# --- LLM Provider Configuration ---
# Options: auto | gemini | openai | groq | anthropic | ollama | fallback
LLM_PROVIDER=auto

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Discovery & Filtering ---
TARGET_DISCOVERY_COUNT=85
MIN_FOLLOWERS=5000
MAX_FOLLOWERS=100000
MIN_ENGAGEMENT_RATE_PCT=0.4
MIN_HIGH_ENGAGEMENT_NANO_FOLLOWERS=2000
HIGH_ENGAGEMENT_NANO_RATE_PCT=2.0
MAX_DAYS_SINCE_LAST_POST=120
REQUIRE_VERIFIED_RECENCY=true
MIN_AVG_VIEWS_FOR_YOUTUBE=500
MIN_NICHE_RELEVANCE_SCORE=0.33

# --- Sending Layer ---
# Supported SEND_MODE values: simulate | smtp
# Live SMTP requires SEND_MODE=smtp AND ALLOW_LIVE_SMTP=true.
SEND_MODE=simulate
SENDER_NAME=Alex Rivera
SENDER_EMAIL=partnerships@voltflow.example
REPLY_TO_EMAIL=partnerships@voltflow.example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=

# --- Storage ---
DATABASE_PATH=data/outreach.db
OUTPUTS_DIR=outputs
