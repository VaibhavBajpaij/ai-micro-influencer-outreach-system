{
  "name": "VoltFlow Automated Micro-Influencer Outreach Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 7
            }
          ]
        }
      },
      "id": "trigger-weekly",
      "name": "Weekly Discovery Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/pipeline/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OUTREACH_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ niche: 'technology', target_count: 85, send_mode: 'simulate', auto_send: false }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "discover-filter-enrich-personalize",
      "name": "Run Discovery, Filter, Enrich & AI Personalize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8000/api/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OUTREACH_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-personalized-messages",
      "name": "Fetch Shortlisted Personalized Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rawItems = $input.all();\nconst validItems = [];\nconst seenIds = new Set();\nconst emailRe = /^[A-Za-z0-9](?:[A-Za-z0-9._%+\\-]*[A-Za-z0-9])?@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,15}$/;\n\nfor (const item of rawItems) {\n  const payload = item?.json;\n  const records = Array.isArray(payload)\n    ? payload\n    : Array.isArray(payload?.data)\n      ? payload.data\n      : Array.isArray(payload?.body)\n        ? payload.body\n        : (payload && typeof payload === 'object' ? [payload] : []);\n\n  for (const record of records) {\n    if (!record || typeof record !== 'object') continue;\n    const id = typeof record.influencer_id === 'string' ? record.influencer_id.trim() : '';\n    if (!id || seenIds.has(id)) continue;\n    seenIds.add(id);\n\n    const email = typeof record.contact_email === 'string' ? record.contact_email.trim() : 'Not Found';\n    const hasValidEmail = Boolean(\n      email &&\n      email.toLowerCase() !== 'not found' &&\n      emailRe.test(email)\n    );\n\n    validItems.push({\n      json: {\n        run_id: typeof record.run_id === 'string' ? record.run_id : '',\n        influencer_id: id,\n        influencer_name: typeof record.influencer_name === 'string' ? record.influencer_name : '',\n        contact_email: email,\n        has_valid_email: hasValidEmail,\n        instagram_url: typeof record.instagram_url === 'string' ? record.instagram_url : 'Not Found',\n        email_subject: typeof record.email_subject === 'string' ? record.email_subject : ''\n      }\n    });\n  }\n}\n\nreturn validItems;"
      },
      "id": "split-validate-messages",
      "name": "Split & Validate Message Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-valid-email",
              "leftValue": "={{ $json.has_valid_email }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "cond-not-found-guard",
              "leftValue": "={{ $json.contact_email }}",
              "rightValue": "Not Found",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-has-id",
              "leftValue": "={{ $json.influencer_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-valid-email",
      "name": "Has Verified Public Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/outreach/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OUTREACH_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: 'simulate', influencer_ids: [$json.influencer_id] }) }}",
        "options": {}
      },
      "id": "dispatch-email-with-dedup",
      "name": "Send / Simulate Email (Duplicate Guarded)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        190
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/api/dm/{{ encodeURIComponent($json.influencer_id) }}/simulate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OUTREACH_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "queue-instagram-dm",
      "name": "Route to Simulated / Manual IG DM Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        410
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8000/api/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OUTREACH_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-outreach-summary",
      "name": "Fetch Final Outreach Tracker Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Discovery Schedule": {
      "main": [
        [
          {
            "node": "Run Discovery, Filter, Enrich & AI Personalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Discovery, Filter, Enrich & AI Personalize": {
      "main": [
        [
          {
            "node": "Fetch Shortlisted Personalized Messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Shortlisted Personalized Messages": {
      "main": [
        [
          {
            "node": "Split & Validate Message Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split & Validate Message Items": {
      "main": [
        [
          {
            "node": "Has Verified Public Email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Verified Public Email?": {
      "main": [
        [
          {
            "node": "Send / Simulate Email (Duplicate Guarded)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Route to Simulated / Manual IG DM Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send / Simulate Email (Duplicate Guarded)": {
      "main": [
        [
          {
            "node": "Fetch Final Outreach Tracker Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route to Simulated / Manual IG DM Queue": {
      "main": [
        [
          {
            "node": "Fetch Final Outreach Tracker Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "2.0.0"
}
